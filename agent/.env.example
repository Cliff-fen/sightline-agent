MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_PROFILE=local
# Profiles: local, claude, deepseek, openai.
# Optional: overrides the served model alias selected by MODEL_PROFILE.
# MODEL_NAME=local-model
MODEL_API_KEY=
MODEL_CONTEXT_WINDOW=65536
MODEL_MAX_TOKENS=8192
MODEL_MAX_IMAGE_BYTES=20971520
TOOL_GATEWAY_URL=http://127.0.0.1:8090
MAX_TURNS=20

# Tool gateway. Keep real keys in the shell or an ignored .env.local file.
SERPER_API_KEY=
JINA_API_KEY=
TOOL_ARTIFACT_DIR=.artifacts
TOOL_MAX_IMAGE_BYTES=20971520

# Optional temporary object staging for reverse-image search.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_OBJECT_PREFIX=sightline-agent
COS_SIGNED_URL_TTL_SECONDS=600
COS_DELETE_AFTER_SEARCH=true

# Optional local image-caption fallback.
IMAGE_CAPTION_BASE_URL=http://127.0.0.1:8000/v1
IMAGE_CAPTION_MODEL=local-model
IMAGE_CAPTION_API_KEY=

# Optional PP-StructureV3-compatible OCR endpoint.
LAYOUT_PARSING_URL=

# Remote profiles use provider-specific credentials. Keep real keys out of files.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
